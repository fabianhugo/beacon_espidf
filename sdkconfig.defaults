# Spike: enable power management + automatic light sleep, which the prebuilt
# framework-arduinoespressif32 libs (pure `framework = arduino`) don't compile in.

# Arduino compiled as an IDF component does NOT provide app_main() unless this is
# set — it's what makes the core's main.cpp define app_main() (initArduino() +
# the setup()/loop() task). Without it the link fails with
# "undefined reference to `app_main'". Requires CONFIG_FREERTOS_HZ=1000 (below).
CONFIG_AUTOSTART_ARDUINO=y

CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y

# BLE controller modem sleep — lets the radio power down between scan windows so
# the SoC can actually reach light sleep (without this the radio is always on and
# ~90 mA, which is what we measured). Mode 1 is the standard/only supported mode.
# The low-power clock must keep running through light sleep: the Xiao C3 has no
# 32 kHz crystal, so use the internal RTC slow RC (matches
# CONFIG_ESP32C3_RTC_CLK_SRC_INT_RC). The RC is imprecise (~±5 %) which can drift
# BLE timing, but this is a connectionless beacon (periodic adverts + passive
# scan), so loose timing is tolerable — verify detection still works on hardware.
# (Replaces the earlier CONFIG_BT_LE_SLEEP_ENABLE line, which is not a valid
# symbol for the C3 controller and silently did nothing.)
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_RTC_SLOW=y
