# Spike: enable power management + automatic light sleep, which the prebuilt
# framework-arduinoespressif32 libs (pure `framework = arduino`) don't compile in.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_BT_LE_SLEEP_ENABLE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
